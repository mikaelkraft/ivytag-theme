{
  "name": "ivytag-theme",
  "displayName": "Ivytag Theme",
  "publisher": "MikaelKraft",
  "description": "A well-crafted dark theme with rich dark greens and vibrant blue accents for an immersive coding experience.",
  "version": "0.7.0",
  "author": {
    "name": "Michael Kraft",
    "url": "https://github.com/mikaelkraft"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "color theme",
    "green",
    "blue",
    "ivytag",
    "ivy",
    "dark",
    "vibrant",
    "forest",
    "emerald"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Ivytag color theme",
        "uiTheme": "vs-dark",
        "path": "./themes/Ivytag-color-theme.json"
      }
    ]
  },
  "scripts": {
    "validate": "node scripts/validate.js",
    "package": "vsce package --no-git-tag-version",
    "test": "npm run validate"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mikaelkraft/ivytag-theme.git"
  },
  "bugs": {
    "url": "https://github.com/mikaelkraft/ivytag-theme/issues"
  },
  "homepage": "https://github.com/mikaelkraft/ivytag-theme#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#05241b",
    "theme": "dark"
  }
}
